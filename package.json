{
  "name": "@0x0kyz/groupmq",
  "version": "1.1.1-next.2",
  "description": "Per-group FIFO queue on Redis with visibility timeouts and retries.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts --sourcemap && node scripts/copy-lua.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "redis",
    "queue",
    "fifo",
    "worker",
    "node",
    "typescript"
  ],
  "author": "0x0kyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x0kyz/groupmq"
  },
  "dependencies": {
    "cron-parser": "^4.9.0"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "devDependencies": {
    "tsdown": "^0.15.4",
    "typescript": "^5.6.2"
  }
}
